<?xml version="1.0" encoding="utf-8"?>
<!--
  FileFly — App-Manifest.
  Kern-Entry-Point ist das System-Share-Sheet: Bilder/Videos aus jeder App (einzeln
  oder im Bulk) an FileFly teilen. Berechtigungen bewusst minimal: Netzwerk (Upload),
  REQUEST_INSTALL_PACKAGES (In-App-Updater), POST_NOTIFICATIONS (Update-/Upload-Hinweis),
  READ_MEDIA_* (Zugriff auf geteilte Medien-URIs unter Android 13+).

  allowBackup=false: der JWT-Token liegt in DataStore; kein Cloud-Backup der App-Daten.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-App-Updater: APK-Installation aus der App heraus. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+: Laufzeit-Prompt für Benachrichtigungen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+: Zugriff auf geteilte Foto-/Video-URIs. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:name=".FileFlyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FileFly"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FileFly.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share-Target: EINE Datei (Bild oder Video) an FileFly teilen. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Share-Target: MEHRERE Dateien (Bulk) an FileFly teilen. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- FileProvider für den APK-Download des Updaters (content:// statt file://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
