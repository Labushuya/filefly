<?xml version="1.0" encoding="utf-8"?>
<!-- Basis-Theme. Das eigentliche Farb-/Typo-System kommt aus Compose (core-ui),
     dieses XML-Theme setzt nur die Fenster-Grundlage vor dem ersten Compose-Frame. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FileFly" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch-/Splash-Theme (androidx core-splashscreen). -->
    <style name="Theme.FileFly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FileFly</item>
    </style>
</resources>
