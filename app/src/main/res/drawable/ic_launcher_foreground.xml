<?xml version="1.0" encoding="utf-8"?>
<!-- FileFly launcher foreground — moth whose wings are media frames
     (left: photo/sun+mountain, right: video/play), glowing body.
     Ring omitted on purpose: adaptive-icon masks would clip it; the black
     background circle carries the emblem feel. Motif kept inside the 72dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ============ LEFT WING (photo frame) ============ -->
    <path android:pathData="M52,40 C44,32 28,24 20,30 C14,36 16,48 28,54 C38,58 47,50 52,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="52" android:startY="30" android:endX="52" android:endY="56">
                <item android:offset="0" android:color="#FFFFD873"/>
                <item android:offset="1" android:color="#FFFF8A1E"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M52,40 C44,32 28,24 20,30 C14,36 16,48 28,54 C38,58 47,50 52,44 Z"
        android:strokeColor="#FFFFC534" android:strokeWidth="1.4"/>
    <!-- photo motif inside left wing: sun + mountains (clipped by wing via group clip) -->
    <group>
        <clip-path android:pathData="M52,40 C44,32 28,24 20,30 C14,36 16,48 28,54 C38,58 47,50 52,44 Z"/>
        <path android:fillColor="#FFFFF3CE" android:pathData="M30,33 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z"/>
        <path android:fillColor="#FFB85200" android:fillAlpha="0.85"
            android:pathData="M20,50 L33,38 L41,45 L48,39 L54,46 L54,56 L20,56 Z"/>
    </group>

    <!-- ============ RIGHT WING (video frame) ============ -->
    <path android:pathData="M56,40 C64,32 80,24 88,30 C94,36 92,48 80,54 C70,58 61,50 56,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="56" android:startY="30" android:endX="56" android:endY="56">
                <item android:offset="0" android:color="#FFFFD873"/>
                <item android:offset="1" android:color="#FFFF8A1E"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M56,40 C64,32 80,24 88,30 C94,36 92,48 80,54 C70,58 61,50 56,44 Z"
        android:strokeColor="#FFFFC534" android:strokeWidth="1.4"/>
    <group>
        <clip-path android:pathData="M56,40 C64,32 80,24 88,30 C94,36 92,48 80,54 C70,58 61,50 56,44 Z"/>
        <path android:fillColor="#FFB85200" android:pathData="M67,34 l9,6 l-9,6 z"/>
    </group>

    <!-- ============ HEAD + ANTENNAE ============ -->
    <path android:fillColor="#FF1B1B1F" android:pathData="M54,37 m-5,0 a5,5.6 0 1,0 10,0 a5,5.6 0 1,0 -10,0 Z"/>
    <path android:fillColor="#00000000" android:strokeColor="#FFFFC534" android:strokeWidth="1.3" android:strokeLineCap="round"
        android:pathData="M52,32 C50,27 46,25 43,26"/>
    <path android:fillColor="#00000000" android:strokeColor="#FFFFC534" android:strokeWidth="1.3" android:strokeLineCap="round"
        android:pathData="M56,32 C58,27 62,25 65,26"/>

    <!-- ============ GLOWING BODY ============ -->
    <path android:pathData="M54,60 m-6.5,0 a6.5,15 0 1,0 13,0 a6.5,15 0 1,0 -13,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="58" android:gradientRadius="16">
                <item android:offset="0" android:color="#FFFFE9A3"/>
                <item android:offset="0.5" android:color="#FFFFC534"/>
                <item android:offset="1" android:color="#FFF26800"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#00000000" android:strokeColor="#FFF26800" android:strokeWidth="1"
        android:pathData="M54,60 m-6.5,0 a6.5,15 0 1,0 13,0 a6.5,15 0 1,0 -13,0 Z"/>
    <path android:fillColor="#FFFFE9A3" android:pathData="M54,79 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 Z"/>
</vector>
